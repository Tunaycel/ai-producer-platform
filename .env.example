# Bu dosya gerçek değer İÇERMEZ — sadece proje hangi environment değişkenlerini bekliyor onu belgeler.
# Yerel geliştirme için: bu dosyayı `.env` olarak kopyala ve gerçek değerleri doldur (.env asla commit edilmez).
# Production/CI için: aynı isimlerle GitHub Actions Secrets / cloud secret manager kullan.

# --- Backend (FastAPI) ---
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI Prodüktör Sohbeti (LLM entegrasyonu eklendiğinde) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Vokal İşleme (RVC / Kits.ai entegrasyonu eklendiğinde) ---
# RVC_API_KEY=
# KITS_AI_API_KEY=

# --- Viral Trend Scanner (gerçek platform API'leri eklendiğinde) ---
# TIKTOK_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# YOUTUBE_DATA_API_KEY=

# --- Abonelik / Ödeme (Stripe vb. eklendiğinde) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Veritabanı & Auth (kullanıcı hesapları / kütüphane) ---
# Prod: gerçek Postgres bağlantı stringi. Yerelde boş bırakılırsa
# uygulama otomatik olarak ./app.db sqlite dosyasına düşer.
# DATABASE_URL=postgresql://user:password@host:5432/ai_producer_platform
# JWT_SECRET_KEY zorunludur — uygulama bunsuz başlamaz (bkz. config.py).
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=1440

# --- Beat/enstrümantal üretimi (ElevenLabs Music API eklendiğinde) ---
# ELEVENLABS_API_KEY=
